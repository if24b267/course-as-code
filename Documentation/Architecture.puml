@startuml CourseAsCode
' Model to represent a moodle course
' https://docs.moodle.org/405/de/Aufbau_einer_Moodle-Site

package Model <<Frame>> {
    class Course {
        String FullName
        String ShortName
        String Summary
        
        DateTime StartDate
        DateTime EndDate
        enum GroupMode
        List<string> Tags
    }
    
    class SensibleDefaults {
        int NumberOfAnnouncementsToDisplay
        enum Format
        bool ShowGrades
        int CourseIdNumber
        int MaximumUploadSize
        bool VisibleToStudents
        bool ForceGroupMode
        string Theme
        bool ShowActivityDates
        bool ShowActivityCompletionConditions
        bool EnableCompletionTracking
        string CategoryName
        string CategoryDescription
    }
    
    class SystemDefaults {
        int Id
        enum SummaryFormat
        bool UsesLegacyFiles
        enum CourseLanguage
        DateTime TimeCreated
        DateTime TimeModified
        string PdfExportFont
        string CustomFields
        string FilePath
    }
   
    class Section {
        string Name
        String Summary
        bool VisibleToStudents
    }
    
    class BackupMetadata {
        string Name
        enum MoodleVersion
        uri MoodleUrl
    }
        
    class User {
        string Username
        MailAdress Email
        string FirstName
        string LastName
        string City
        enum Country
        string Description
        
        bool HasPicture
        string PictureDescription
        MoodleFile Picture
        
        enum AuthMethod
    }
    
    abstract class EnrolmentMethod {
        Role DefaultRole
        bool Enabled
    }
    
    class GuestEnrolment extends EnrolmentMethod {
        string Password
    }
    
    class ManualEnrolment extends EnrolmentMethod {
        int EnrolmentDuration
        bool NotifyEnroller
        bool NotifyStudent
        bool SendWelcomeMessage
        string WelcomeMessage
    }
    
    class SelfEnrolment extends EnrolmentMethod {
        string CustomName
        string Password
        int EnrolmentDuration
        bool NotifyEnroller
        bool NotifyStudent
        bool SendWelcomeMessage
        string WelcomeMessage
    }
    
    class Role {
        string Name
        string ShortName
        string LocalName
        string Description
        enum Archetype
    }
    
    ' https://docs.moodle.org/405/en/Activities
    package Activities <<Folder>> {
        abstract class Activity {
            int Id
            string Name
            string Description
            enum GroupMode
            List<string> tags
        }

        'Assignments - Enable teachers to grade and give comments on uploaded files and assignments created on and off line
        class Assignment {
            String openDate
            String dueDate
            String submissionType
            int grade
        }

        'Forum - Allows participants to have asynchronous discussions
        class Forum {
            String type
            String openDate
            String closeDate
            List<ForumPost> posts
        }

        class ForumPost {
            String author
            DateTime postDate
            String content
            List<ForumComment> comments
        }

        class ForumComment {
            String author
            DateTime commentDate
            String content
        }

        'Quiz - Allows the teacher to design and set quiz tests, which may be automatically marked and feedback and/or to correct answers shown
        class Quiz {
            String openDate
            String closeDate
            int timeLimit
            int grade
            List<QuizQuestion> questions
        }

        abstract class QuizQuestion {
            int id
            String questionType
            String title
        }

        class MultipleChoiceQuestion {
            List<String> options
            String correctAnswer
        }

        class TrueFalseQuestion {
            boolean correctAnswer
        }

        class CodeRunnerQuestion {
            String code
            String language
            List<CodeRunnerTestCase> testCases
        }

        class CodeRunnerTestCase {
            String input
            String output
        }
    }


    ' https://docs.moodle.org/405/en/Resources
    ' Resources are types of activities
    package Resources <<Folder>> {
        ' File - A picture, PDF file, spreadsheet, sound file, video file or any other file type. Where possible, the file will be displayed within the course interface; otherwise students will be prompted to download it.
        class MoodleFile {
            string FileName
            string FilePath
        }

        ' URL - For providing a web link as a course resource.
        class URL {
            String ExternalUrl
        }
    }
}

package Reader <<Frame>> {
    Interface CourseReader {
        Course Read(String path, enum format)
    }

    class Reader implements CourseReader {

    }

    Interface IModelObjectReader<T, TFileObject> {
        T Read(TFileObject fileObject)
    }

    abstract class AssignmentReader implements IModelObjectReader {

    }

    class XMLAssignmentReader implements AssignmentReader {

    }

    class MDAssignmentReader implements AssignmentReader {

    }

    class SCORMAssignmentReader implements AssignmentReader {

    }

    abstract class ForumReader implements IModelObjectReader {

    }

    abstract class QuizReader implements IModelObjectReader {

    }

    abstract class FileReader implements IModelObjectReader {

    }

    abstract class URLReader implements IModelObjectReader {

    }
}

package Writer <<Frame>> {
    Interface IWriter {
        + bool WriteCourse(Course course, string outputPath);
    }

    class XMLWriter implements IWriter {

    }

    class PDFWriter implements IWriter {

    }

    class SCORMWriter implements IWriter {

    }
    
    abstract class XmlWriterBase {
        ~ void WriteElements(XmlWriter writer, Dictionary<string, string> elements)
        ~ void WriteStartElementWithAttributes(XmlWriter writer, string elementName, Dictionary<string, string> attributes)
    }

    class MoodleBackupWriter implements XmlWriterBase {
        + void WriteMoodleBackup(Course course, string outputPath)
        - void WriteGeneralSettingsToInformationSection(XmlWriter writer, Course course)
        - void WriteDetailsSection(XmlWriter writer, Course course)
        - void WriteContentsSection(XmlWriter writer, Course course)
        - void WriteContentsCourseSubsection(XmlWriter writer, Course course)
        - void WriteSettingsSection(XmlWriter writer, Course course)
        - void WriteRootLevelSettings(XmlWriter writer, Course course)
        - void WriteSingleBackupSettingTag(XmlWriter writer, string level, string name, string value)
    }

    class FilesWriter implements XmlWriterBase {
        + void WriteFiles(Course course, string outputPath)
        - void WriteSingleFile(XmlWriter writer, MoodleFile file)
        - string GetSha1Hash(FileStream fileStream)
    }

    class CourseWriter implements XmlWriterBase {
        + void WriteCourse(Course course, string outputPath)
        - void WriteGeneralInformationToCourseSection(XmlWriter writer, Course course)
        - void WriteCategorySection(XmlWriter writer, Course course)
        - void WriteTagsSection(XmlWriter writer, Course course)
        - void WriteCustomFieldsSection(XmlWriter writer, Course course)
        - void WriteCourseFormatOptionsSection(XmlWriter writer, Course course)
    }
}

' SensibleDefaults and SystemDefaults are subclasses of Course (nested class)
Course +-- SensibleDefaults
Course +-- SystemDefaults

' The course is associated with the backup metadata
Course "1" *-- "1" BackupMetadata : described by

' A user is assigned a Role
User "0..*" *-- "1" Role : assigned

' A user was enrolled using an enrolment method
User "0..*" *-- "1" EnrolmentMethod : enrolled

' There are multiple roles available in a course
Course "1" *-- "0..*" Role : configures

' A course supports multiple enrolment methods
Course "1" *-- "0..*" EnrolmentMethod : supports

' A course has a number of enrolled users
Course "0..*" *-- "0..*" User : enrolled




' A course consists of multiple sections
Course "1" *-- "0..*" Section : contains

' A section consists of multiple activities
Section "1" *-- "0..*" Activity : contains

' A forum can contain multiple posts
Forum "1" *-- "0..*" ForumPost : contains

' A forum post can contain multiple comments
ForumPost "1" *-- "0..*" ForumComment : contains

' A quiz contains one or multiple questions
Quiz "1" *-- "1..*" QuizQuestion : contains

' A code runner question contains one or multiple test cases
CodeRunnerQuestion "1" *-- "0..*" CodeRunnerTestCase : contains

' A quiz question can be a multiple choice, True/False or CodeRunner question
QuizQuestion <|-- MultipleChoiceQuestion
QuizQuestion <|-- TrueFalseQuestion
QuizQuestion <|-- CodeRunnerQuestion

' A file is a type of activity
Activity <|-- MoodleFile : is a

' An activity can be an assignment, forum or quiz
Activity <|-- Assignment
Activity <|-- Forum
Activity <|-- Quiz

' The XMLWriter calls the methods of MoodleBackupWriter, FilesWriter, CourseWriter, etc.
XMLWriter o-- MoodleBackupWriter : calls
XMLWriter o-- FilesWriter : calls
XMLWriter o-- CourseWriter : calls

' TODO: Writer implements classes that implement IModelObjectWriter

@enduml
