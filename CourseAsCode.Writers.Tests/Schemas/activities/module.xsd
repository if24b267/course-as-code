<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="module">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="modulename" type="xs:string"/>
				<xs:element name="sectionid" type="xs:int"/>
				<xs:element name="sectionnumber" type="xs:int"/>
				<xs:element name="idnumber" type="xs:string"/>
				<xs:element name="added" type="xs:int"/>
				<xs:element name="score" type="xs:int"/>
				<xs:element name="indent" type="xs:int"/>
				<xs:element name="visible" type="xs:int"/>
				<xs:element name="visibleoncoursepage" type="xs:int"/>
				<xs:element name="visibleold" type="xs:int"/>
				<xs:element name="groupmode" type="xs:int"/>
