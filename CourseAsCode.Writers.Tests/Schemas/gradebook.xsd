<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="gradebook">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="attributes">
					<xs:complexType>
						<xs:sequence>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="grade_categories">
					<xs:complexType>
						<xs:sequence>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="grade_items">
					<xs:complexType>
						<xs:sequence>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="grade_letters">
					<xs:complexType>
						<xs:sequence>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="grade_settings">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="grade_setting" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="name" type="xs:string"/>
										<xs:element name="value" type="xs:string"/>
									</xs:sequence>
									<xs:attribute name="id" type="xs:string" use="required"/>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>


