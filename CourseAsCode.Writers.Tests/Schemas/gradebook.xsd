<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="gradebook">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="attributes">
					<xs:complexType>
						<xs:sequence>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="grade_categories">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="grade_category" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="parent" type="xs:string"/>
										<xs:element name="depth" type="xs:int"/>
										<xs:element name="path" type="xs:string"/>
										<xs:element name="fullname" type="xs:string"/>
										<xs:element name="aggregation" type="xs:int"/>
										<xs:element name="keephigh" type="xs:int"/>
										<xs:element name="droplow" type="xs:int"/>
										<xs:element name="aggregateonlygraded" type="xs:int"/>
										<xs:element name="aggregateoutcomes" type="xs:int"/>
										<xs:element name="timecreated" type="xs:int"/>
										<xs:element name="timemodified" type="xs:int"/>
										<xs:element name="hidden" type="xs:int"/>
									</xs:sequence>
									<xs:attribute name="id" type="xs:string" use="required"/>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="grade_items">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="grade_item" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="categoryid" type="xs:string"/>
										<xs:element name="itemname" type="xs:string"/>
										<xs:element name="itemtype" type="xs:string"/>
										<xs:element name="itemmodule" type="xs:string"/>
										<xs:element name="iteminstance" type="xs:int"/>
										<xs:element name="itemnumber" type="xs:string"/>
										<xs:element name="iteminfo" type="xs:string"/>
										<xs:element name="idnumber" type="xs:string"/>
										<xs:element name="calculation" type="xs:string"/>
										<xs:element name="gradetype" type="xs:int"/>
										<xs:element name="grademax" type="xs:decimal"/>
										<xs:element name="grademin" type="xs:decimal"/>
										<xs:element name="scaleid" type="xs:string"/>
										<xs:element name="outcomeid" type="xs:string"/>
										<xs:element name="gradepass" type="xs:decimal"/>
										<xs:element name="multfactor" type="xs:decimal"/>
										<xs:element name="plusfactor" type="xs:decimal"/>
										<xs:element name="aggregationcoef" type="xs:decimal"/>
										<xs:element name="aggregationcoef2" type="xs:decimal"/>
										<xs:element name="weightoverride" type="xs:int"/>
										<xs:element name="sortorder" type="xs:int"/>
										<xs:element name="display" type="xs:int"/>
										<xs:element name="decimals" type="xs:string"/>
										<xs:element name="hidden" type="xs:int"/>
										<xs:element name="locked" type="xs:int"/>
										<xs:element name="locktime" type="xs:int"/>
										<xs:element name="needsupdate" type="xs:int"/>
										<xs:element name="timecreated" type="xs:int"/>
										<xs:element name="timemodified" type="xs:int"/>
										<xs:element name="grade_grades">
											<xs:complexType>
												<xs:sequence>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
									<xs:attribute name="id" type="xs:string" use="required"/>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="grade_letters">
					<xs:complexType>
						<xs:sequence>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="grade_settings">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="grade_setting" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="name" type="xs:string"/>
										<xs:element name="value" type="xs:string"/>
									</xs:sequence>
									<xs:attribute name="id" type="xs:string" use="required"/>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>