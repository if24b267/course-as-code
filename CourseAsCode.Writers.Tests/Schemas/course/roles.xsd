<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="roles">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="role_overrides">
					<xs:complexType>
						<xs:sequence>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="role_assignments">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="assignment" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="roleid" type="xs:int"/>
										<xs:element name="userid" type="xs:int"/>
										<xs:element name="timemodified" type="xs:int"/>
										<xs:element name="modifierid" type="xs:int"/>
										<xs:element name="component" type="xs:string"/>
										<xs:element name="itemid" type="xs:int"/>
										<xs:element name="sortorder" type="xs:int"/>
									</xs:sequence>
									<xs:attribute name="id" type="xs:int" use="required"/>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>