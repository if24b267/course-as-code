<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="enrolments">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="enrols">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="enrol" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="enrol" type="xs:string"/>
										<xs:element name="status" type="xs:int"/>
										<xs:element name="name" type="xs:string"/>
										<xs:element name="enrolperiod" type="xs:int"/>
										<xs:element name="enrolstartdate" type="xs:int"/>
										<xs:element name="enrolenddate" type="xs:int"/>
										<xs:element name="expirynotify" type="xs:int"/>
										<xs:element name="expirythreshold" type="xs:int"/>
										<xs:element name="notifyall" type="xs:int"/>
										<xs:element name="password" type="xs:string"/>
										<xs:element name="cost" type="xs:string"/>
										<xs:element name="currency" type="xs:string"/>
										<xs:element name="roleid" type="xs:int"/>
										<xs:element name="customint1" type="xs:int"/>
										<xs:element name="customint2" type="xs:string"/>
										<xs:element name="customint3" type="xs:string"/>
										<xs:element name="customint4" type="xs:string"/>
										<xs:element name="customint5" type="xs:string"/>
										<xs:element name="customint6" type="xs:string"/>
										<xs:element name="customint7" type="xs:string"/>
										<xs:element name="customint8" type="xs:string"/>
										<xs:element name="customchar1" type="xs:string"/>
										<xs:element name="customchar2" type="xs:string"/>
										<xs:element name="customchar3" type="xs:string"/>
										<xs:element name="customdec1" type="xs:string"/>
										<xs:element name="customdec2" type="xs:string"/>
										<xs:element name="customtext1" type="xs:string"/>
										<xs:element name="customtext2" type="xs:string"/>
										<xs:element name="customtext3" type="xs:string"/>
										<xs:element name="customtext4" type="xs:string"/>
										<xs:element name="timecreated" type="xs:int"/>
										<xs:element name="timemodified" type="xs:int"/>
										<xs:element name="user_enrolments">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="enrolment" maxOccurs="unbounded">
														<xs:complexType>
															<xs:sequence>
																<xs:element name="status" type="xs:int"/>
																<xs:element name="userid" type="xs:int"/>
																<xs:element name="timestart" type="xs:int"/>
																<xs:element name="timeend" type="xs:int"/>
																<xs:element name="modifierid" type="xs:int"/>
																<xs:element name="timemodified" type="xs:int"/>
															</xs:sequence>
															<xs:attribute name="id" type="xs:int" use="required"/>
														</xs:complexType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
									<xs:attribute name="id" type="xs:int" use="required"/>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>