<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="course">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="shortname" type="xs:string" />
				<xs:element name="fullname" type="xs:string" />
				<xs:element name="idnumber" type="xs:string" minOccurs="0" />
				<xs:element name="summary" type="xs:string" />
				<xs:element name="summaryformat" type="xs:int" />
				<xs:element name="format" type="xs:string" />
				<xs:element name="showgrades" type="xs:int" />
				<xs:element name="newsitems" type="xs:int" />
				<xs:element name="startdate" type="xs:int" />
				<xs:element name="enddate" type="xs:int" />
				<xs:element name="marker" type="xs:int" />
				<xs:element name="maxbytes" type="xs:int" />
				<xs:element name="legacyfiles" type="xs:int" />
				<xs:element name="showreports" type="xs:int" />
				<xs:element name="visible" type="xs:int" />
				<xs:element name="groupmode" type="xs:int" />
				<xs:element name="groupmodeforce" type="xs:int" />
				<xs:element name="defaultgroupingid" type="xs:int" />
				<xs:element name="lang" type="xs:string" />
				<xs:element name="theme" type="xs:string" />
				<xs:element name="timecreated" type="xs:int" />
				<xs:element name="timemodified" type="xs:int" />
				<xs:element name="requested" type="xs:int" />
				<xs:element name="showactivitydates" type="xs:int" />
				<xs:element name="showcompletionconditions" type="xs:int" />
				<xs:element name="pdfexportfont" type="xs:string" />
				<xs:element name="enablecompletion" type="xs:int" />
				<xs:element name="completionnotify" type="xs:int" />
				<xs:element name="category">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="name" type="xs:string" />
							<xs:element name="description" type="xs:string" />
						</xs:sequence>
						<xs:attribute name="id" type="xs:int" use="required" />
					</xs:complexType>
				</xs:element>
				<xs:element name="tags">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="tag" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="name" type="xs:string" />
										<xs:element name="rawname" type="xs:string" />
									</xs:sequence>
									<xs:attribute name="id" type="xs:int" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="customfields" type="xs:string" minOccurs="0" />
				<xs:element name="courseformatoptions">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="courseformatoption" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="format" type="xs:string" />
										<xs:element name="sectionid" type="xs:int" />
										<xs:element name="name" type="xs:string" />
										<xs:element name="value" type="xs:string" />
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="id" type="xs:int" use="required" />
			<xs:attribute name="contextid" type="xs:int" use="required" />
		</xs:complexType>
	</xs:element>
</xs:schema>