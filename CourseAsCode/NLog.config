<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<!-- Define logging levels and targets -->
	<targets>
		<!-- Log to a file -->
		<target xsi:type="File" name="fileLogger" fileName="${basedir}/logs/app.log" deleteOldFileOnStartup="true"
		        layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message} ${exception}" />
		
		<!-- Log to the console -->
		<target xsi:type="Console" name="console"
		        layout="${longdate} | ${level:uppercase=true} | ${message}" />
	</targets>

	<!-- Define logging rules -->
	<rules>
		<!-- Log everything (Trace and higher) to the file -->
		<logger name="*" minlevel="Trace" writeTo="fileLogger" />

		<!-- Log only Warning and higher to the console -->
		<logger name="*" minlevel="Trace" writeTo="console" />
	</rules>
</nlog>