<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CourseAsCode.Model\CourseAsCode.Model.csproj" />
    <ProjectReference Include="..\CourseAsCode.Readers\CourseAsCode.Readers.csproj" />
    <ProjectReference Include="..\CourseAsCode.Writers\CourseAsCode.Writers.csproj" />
    <ProjectReference Include="..\CourseAsCode.Uploader\CourseAsCode.Uploader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
