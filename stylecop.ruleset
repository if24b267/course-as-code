<?xml version="1.0" encoding="utf-8"?>
<RuleSet Name="CourseAsCode Rules" Description="Custom rule set for CourseAsCode." ToolsVersion="16.0">
  <Rules AnalyzerId="StyleCop.Analyzers" RuleNamespace="StyleCop.Analyzers">
    <!-- Disable underscore field naming rule -->
    <Rule Id="SA1309" Action="None" />
    <Rule Id="SX1309" Action="None" />
    <Rule Id="SA1310" Action="None" /> <!-- Field names should not contain underscores (except for private fields) -->
    
    <!-- Disable 'this.' prefix requirement -->
    <Rule Id="SA1101" Action="None" />
    
    <!-- Enable alternative 'this.' prefix preference -->
    <Rule Id="SX1101" Action="None" />
    
    <!-- Optional documentation rules -->
    <Rule Id="SA1600" Action="None" /> <!-- Elements should be documented -->
    <Rule Id="SA1601" Action="None" /> <!-- Partial elements should be documented -->
    <Rule Id="SA1602" Action="None" /> <!-- Enumeration items should be documented -->
    <Rule Id="SA1611" Action="None" /> <!-- Element parameters must be documented -->
    <Rule Id="SA1614" Action="None" /> <!-- Element parameter documentation should have text -->
    <Rule Id="SA1615" Action="None" /> <!-- Element return value must be documented -->
    <Rule Id="SA1616" Action="None" /> <!-- Element return value documentation should have text -->
    <Rule Id="SA1618" Action="None" /> <!-- Generic type parameters must be documented -->
    <Rule Id="SA1622" Action="None" /> <!-- Generic type parameter documentation should have text -->
    <Rule Id="SA1642" Action="None" /> <!-- Constructor summary documentation should begin with standard text -->
    
    <!-- Allow multiple statements on a single line -->
    <Rule Id="SA1107" Action="None" />
    
    <!-- Allow parameters on multiple lines -->
    <Rule Id="SA1117" Action="None" />
    
    <!-- Allow parameter list in declaration to span multiple lines -->
    <Rule Id="SA1118" Action="None" />
    
    <!-- Allow regions -->
    <Rule Id="SA1124" Action="None" />
    
    <!-- Allow documentation text to end with a period -->
    <Rule Id="SA1629" Action="None" />
    
    <!-- Allow elements without blank lines between them -->
    <Rule Id="SA1516" Action="None" />
    
    <!-- Disable file header requirement -->
    <Rule Id="SA1633" Action="None" />
    
    <!-- File name must match type name -->
    <Rule Id="SA1649" Action="None" />
    
    <!-- File may only contain a single type -->
    <Rule Id="SA1402" Action="None" />

    <!-- Field order and element ordering -->
    <Rule Id="SA1214" Action="None" /> <!-- Readonly fields should appear before non-readonly fields -->
    <Rule Id="SA1202" Action="None" /> <!-- Elements should be ordered by access -->
    <Rule Id="SA1201" Action="None" /> <!-- Elements should be ordered by category -->
    <Rule Id="SA1203" Action="None" /> <!-- Constants should appear before fields -->
    <Rule Id="SA1204" Action="None" /> <!-- Static members should appear before instance members -->
    
    <!-- Opening square brackets should not be followed by a space -->
    <Rule Id="SA1010" Action="None" />
    
    <!-- Use string.Empty instead of "" -->
    <Rule Id="SA1122" Action="None" />
    
    <!-- Access modifier must be declared -->
    <Rule Id="SA1400" Action="None" />
    
    <!-- Fields should be private -->
    <Rule Id="SA1401" Action="None" />
  </Rules>
  
  <Rules AnalyzerId="Roslynator.CSharp.Analyzers" RuleNamespace="Roslynator.CSharp.Analyzers">
    <Rule Id="RCS1102" Action="None" /> <!-- Make class static -->
  </Rules>
  
  <Rules AnalyzerId="Microsoft.CodeAnalysis" RuleNamespace="Microsoft.CodeAnalysis">
    <!-- Disable nested type should not be visible warning -->
    <Rule Id="CA1034" Action="None" />
    <!-- Disable generic exception catching warning -->
    <Rule Id="CA1031" Action="None" />
    <!-- Matching reader style -->
    <Rule Id="CA2211" Action="None" /> <!-- Non-constant field should not be visible -->
    <Rule Id="CA1000" Action="None" /> <!-- Do not declare static members on generic types -->
    <Rule Id="CA1707" Action="None" /> <!-- Identifiers should not contain underscores -->
    <Rule Id="CA1305" Action="None" /> <!-- Specify IFormatProvider -->
    <Rule Id="CA2213" Action="None" /> <!-- Disposable fields should be disposed -->
    <Rule Id="CA2214" Action="None" /> <!-- Do not call overridable methods in constructors -->
    <Rule Id="CA1823" Action="None" /> <!-- Avoid unused private fields -->
    <Rule Id="CA2000" Action="None" /> <!-- Dispose objects before losing scope -->
    <Rule Id="CA1861" Action="None" /> <!-- Prefer 'static readonly' fields over constant array arguments -->
    <Rule Id="CA1859" Action="None" /> <!-- Use concrete types when possible for improved performance -->
    <Rule Id="CA1051" Action="None" /> <!-- Do not declare visible instance fields -->
    <Rule Id="CA1716" Action="None" /> <!-- Identifiers should not match keywords -->
    <Rule Id="CA1805" Action="None" /> <!-- Do not initialize unnecessarily -->
    <Rule Id="CA5350" Action="None" /> <!-- Do Not Use Weak Cryptographic Algorithms -->
    <Rule Id="SYSLIB1045" Action="None" /> <!-- Convert to 'File.ReadAllText' -->  
  </Rules>
  
  <Rules AnalyzerId="Microsoft.CodeAnalysis.CSharp.Features" RuleNamespace="Microsoft.CodeAnalysis.CSharp.Features">
    <!-- Disable IDE0090: Simplify new expression -->
    <Rule Id="IDE0090" Action="None" />
    <!-- Disable IDE0055: Fix formatting -->
    <Rule Id="IDE0055" Action="None" />
    <!-- Matching reader style -->
    <Rule Id="IDE0007" Action="None" /> <!-- Use var instead of explicit type -->
    <Rule Id="IDE0008" Action="None" /> <!-- Use explicit type instead of var -->
    <Rule Id="IDE0060" Action="None" /> <!-- Remove unused parameter -->
    <Rule Id="IDE0051" Action="None" /> <!-- Remove unused private member -->
    <Rule Id="IDE0073" Action="None" /> <!-- File header -->
    <Rule Id="IDE1006" Action="None" /> <!-- Naming rule violation -->
    <Rule Id="IDE0160" Action="None" /> <!-- Use block-scoped namespace -->
    <Rule Id="IDE0290" Action="None" /> <!-- Use primary constructor -->
    <Rule Id="IDE0058" Action="None" /> <!-- Expression value is never used -->
    <Rule Id="IDE0010" Action="None" /> <!-- Add missing cases to switch statement -->
    <Rule Id="IDE0005" Action="None" /> <!-- Using directive is unnecessary -->
    <Rule Id="IDE0028" Action="None" /> <!-- Use collection initializer -->
    <Rule Id="IDE0040" Action="None" /> <!-- Add accessibility modifiers -->
    <Rule Id="IDE0057" Action="None" /> <!-- Use range operator -->
    <Rule Id="IDE0059" Action="None" /> <!-- Unnecessary assignment of a value -->
    <Rule Id="IDE0063" Action="None" /> <!-- Use simple 'using' statement -->
    <Rule Id="IDE0072" Action="None" /> <!-- Add missing cases to switch expression -->
    <Rule Id="IDE0074" Action="None" /> <!-- Use compound assignment -->
    <Rule Id="IDE0078" Action="None" /> <!-- Use pattern matching -->
    <Rule Id="IDE0210" Action="None" /> <!-- Convert to top-level statements -->
    <Rule Id="IDE0300" Action="None" /> <!-- Use collection expression for array -->
  </Rules>
</RuleSet>